# Database
DATABASE_URL="postgresql://username:password@localhost:5432/font_license_checker"

# Iron Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET="your-secret-key-at-least-32-characters-long-replace-this"

# Admin credentials (set on first run or via seed)
